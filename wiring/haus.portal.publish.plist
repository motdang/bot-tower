<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>haus.portal.publish</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/annikapeacock/Developer/claude code projects/bot-tower/tower.py</string>
        <string>run</string>
        <string>portal-publish</string>
        <!-- 40 minutes of patience: the only bot it can queue behind is
             lannawiki-publish, whose upload runs about 25 minutes, and
             cloudflare-deploy keeps a 5-minute courtesy gap after it. -->
        <string>--patience</string>
        <string>40</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>40</integer>
    </dict>
    <key>StandardOutPath</key><string>/tmp/bottower-portal-publish.log</string>
    <key>StandardErrorPath</key><string>/tmp/bottower-portal-publish.log</string>
</dict>
</plist>
